load("@rules_img//img:layer.bzl", "image_layer")
load("@rules_img//img:image.bzl", "image_manifest")
load("@rules_img//img:load.bzl", "image_load")
load("@rules_python//python:defs.bzl", "py_binary")

licenses(["notice"])

py_binary(
    name = "server",
    srcs = ["server.py"],
    deps = [
        "@pypi//absl_py",
        "@pypi//etils",
        "@pypi//flask",
        "@pypi//jax",
        # "@pypi//simple_parsing",  # why is this not included automatically?
        # "@pypi//importlib_resources",  # why is this not included automatically?
    ],
)

image_layer(
    name = "server_layer",
    srcs = {
        "/app/server": ":server",
    },
)

image_manifest(
    name = "server_image",
    base = "@docker_io_python",
    entrypoint = ["/app/server"],
    layers = [":server_layer"],
)

image_load(
    name = "server_image.load",
    image = ":server_image",
    tag = "server:latest",
)

filegroup(
    name = "server_image.tar",
    srcs = [":server_image.load"],
    output_group = "tarball",
)
