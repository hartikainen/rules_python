load("@aspect_rules_py//py:defs.bzl", "py_binary", "py_image_layer", "py_layer_tier")
load("@rules_img//img:image.bzl", "image_manifest")
load("@rules_img//img:load.bzl", "image_load")

licenses(["notice"])

alias(
    name = "requirements.update",
    actual = "@uv",
)

platform(
    name = "linux_aarch64",
    constraint_values = [
        "@platforms//cpu:aarch64",
        "@platforms//os:linux",
    ],
    flags = ["--@aspect_rules_py//uv/private/constraints/platform:platform_libc=glibc"],
)

platform(
    name = "linux_x86_64",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
    flags = ["--@aspect_rules_py//uv/private/constraints/platform:platform_libc=glibc"],
)

py_binary(
    name = "server",
    srcs = ["server.py"],
    dep_group = "oci-container-example",
    deps = [
        "@pypi//absl_py",
        "@pypi//etils",
        "@pypi//flask",
        "@pypi//importlib_resources",
        "@pypi//jax",
        "@pypi//simple_parsing",
    ],
)

py_layer_tier(
    name = "server_layer_tier",
    compression = {
        "jaxlib": [
            "gzip",
            "1",
        ],
    },
    groups = {
        "@pip//jax:jax": "jax",
        "@pip//jaxlib:jaxlib": "jaxlib",
        "@pip//ml_dtypes:ml_dtypes": "ml_dtypes",
        "@pip//numpy:numpy": "numpy",
        "@pip//scipy:scipy": "scipy",
    },
    interpreter_group = "interpreter",
)

py_image_layer(
    name = "server_layer",
    binary = ":server",
    launcher_dir = "/app",
    layer_tier = ":server_layer_tier",
)

image_manifest(
    name = "server_image",
    base = "@docker_io_python",
    entrypoint = ["/app/server"],
    env = {"RUNFILES_DIR": "/app.runfiles"},
    layers = [":server_layer"],
    platform = select({
        "@platforms//cpu:aarch64": ":linux_aarch64",
        "@platforms//cpu:x86_64": ":linux_x86_64",
    }),
)

image_load(
    name = "server_image.load",
    image = ":server_image",
    tag = "server:latest",
)

filegroup(
    name = "server_image.tar",
    srcs = [":server_image.load"],
    output_group = "tarball",
)
