"""Example of python inside container."""

module(
    name = "oci-container-example",
    version = "0.0.1",
)

bazel_dep(name = "aspect_rules_py", version = "2.0.0-alpha.6")
bazel_dep(name = "rules_img", version = "0.3.19")
bazel_dep(name = "rules_python", version = "2.3.1")
bazel_dep(name = "platforms", version = "1.1.0")

# local_path_override(
#     module_name = "rules_python",
#     path = "../..",
# )

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    is_default = True,
    python_version = "3.12",
)
python.override(minor_mapping = {"3.12": "3.12.12"})

uv_bin = use_extension("@aspect_rules_py//uv:extensions.bzl", "uv_bin")
uv_bin.toolchain()
use_repo(uv_bin, "uv")

uv = use_extension("@aspect_rules_py//uv:extensions.bzl", "uv")
uv.declare_hub(
    hub_name = "pypi",
)
uv.project(
    hub_name = "pypi",
    lock = "//:uv.lock",
    pyproject = "//:pyproject.toml",
)
use_repo(uv, "pypi")

pull = use_repo_rule("@rules_img//img:pull.bzl", "pull")

pull(
    name = "docker_io_python",
    digest = "sha256:034724ef64585eeb0e82385e9aabcbeabfe5f7cae2c2dcedb1da95114372b6d7",
    layer_handling = "lazy",
    registry = "index.docker.io",
    repository = "library/python",
    tag = "3.12-slim",
)
